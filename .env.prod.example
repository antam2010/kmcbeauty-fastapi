# ==============================================================================
# .env.prod 템플릿 — 운영 서버(docker compose 프로젝트 kmcbeauty)의 비시크릿 설정
#   SPEC-INFRA-001 REQ-INFRA-001 / SPEC-INFRA-002 REQ-INFRA-108
#
# 사용법:
#   - 서버의 배포 디렉터리(기본 /srv/server-mini2/web/kmcbeauty-fastapi)에서만 만든다:
#       cp .env.prod.example .env.prod && chmod 600 .env.prod
#   - `.env.prod` 는 절대 저장소에 커밋하지 않는다(.gitignore 로 차단, 공개 저장소).
#     git 미추적 파일이라 CD 의 `git checkout --force` 뒤에도 그대로 남는다.
#   - compose.prod.yaml 의 env_file 로 세 컨테이너에 들어간다. scripts/deploy.sh 가 값을 글자 그대로
#     비교하므로 한 줄에 KEY=값 만 쓴다(따옴표 · 뒤 주석 · `export` · `$` 없이).
#
# 시크릿은 이 파일에 두지 않는다 — 서버의 ./secrets/ 파일(compose secrets)로만 주입한다:
#   ./secrets/ 디렉터리 0700(배포 계정 소유), 파일 0644(컨테이너의 시스템 uid 가 읽는다),
#   값 끝에 줄바꿈 없이(printf). 컨테이너 안에서는 /run/secrets/<target> 이다.
#     secrets/secret_key                    -> SECRET_KEY
#     secrets/fernet_key                    -> FERNET_KEY
#     secrets/database_url                  -> DATABASE_URL
#     secrets/redis_url                     -> REDIS_URL
#     secrets/rate_limit_storage_uri        -> RATE_LIMIT_STORAGE_URI (api 만)
#     secrets/firebase_service_account.json -> firebase_service_account (경로는 compose.prod.yaml 이 고정)
#   값 형식(공유 PostgreSQL · 공유 Redis — 비밀번호의 URL 특수문자는 퍼센트 인코딩):
#     DATABASE_URL           postgresql+psycopg://kmcbeauty:<password>@postgresql:5432/kmcbeauty
#     REDIS_URL              redis://:<password>@redis:6379/5   (캐시·리프레시 토큰·Celery 브로커/결과)
#     RATE_LIMIT_STORAGE_URI redis://:<password>@redis:6379/6   (rate limit 카운터)
#     firebase_service_account.json  실제 키 JSON. 아직 없으면 '{}' — Firebase 초기화만 실패하고
#                                    API · worker · beat 는 뜬다(푸시 발송은 실제 키 전까지 실패).
#   만드는 법은 docs/deployment.md 10절 (c), 교체는 9절.
#
#   위 시크릿 필드(SECRET_KEY · FERNET_KEY · DATABASE_URL · REDIS_URL · RATE_LIMIT_STORAGE_URI)를
#   이 파일에 (빈 값이라도) 정의하면 env 가 /run/secrets 파일보다 우선해 시크릿을 조용히 덮어쓴다
#   (Settings 우선순위 env > .env > secrets). scripts/deploy.sh 가 배포를 거부한다.
#
# 로컬 개발용 `.env` 와는 일부러 다르다:
#   - 로컬 `.env`      : 시크릿·REDIS_URL 을 평문으로 두고 compose.dev 의 redis 를 쓴다.
#   - 운영 `.env.prod` : 비시크릿만. 로컬 `.env` 를 서버에 복사하지 않는다.
#
# scripts/deploy.sh 사전 검사가 배포를 중단하는 조건(이 파일 관련):
#   파일 없음, APP_ENV 가 정확히 production 이 아님, 위 시크릿 필드 정의 줄 존재,
#   FORWARDED_ALLOW_IPS 비었음 · `*` 포함 · shared_network_prod 의 nginx IP 와 다름.
# ==============================================================================

# --- 환경 식별 --------------------------------------------------------------
# APP_ENV: 애플리케이션 런타임 환경(app.core.config). 허용값: local|debug|stage|production — 운영은 production.
APP_ENV=production
# ENV: alembic/env.py 가 .env.{ENV} 를 로드할 때 사용(운영은 prod).
ENV=prod

# --- 인증/보안(비시크릿만) --------------------------------------------------
# ALGORITHM: JWT 서명 알고리즘.
ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_SECONDS: 액세스 토큰 만료(초).
ACCESS_TOKEN_EXPIRE_SECONDS=900
# REFRESH_TOKEN_EXPIRE_SECONDS: 리프레시 토큰 만료(초).
REFRESH_TOKEN_EXPIRE_SECONDS=1209600

# --- 프록시 신뢰(nginx -> uvicorn) ------------------------------------------
# FORWARDED_ALLOW_IPS: uvicorn 이 X-Forwarded-For/Proto 를 믿을 프록시 주소.
#   shared_network_prod 에서의 공유 nginx 컨테이너 IP 하나다(nginx 는 그 네트워크에 고정 IP 로 붙어 있다).
#   서버에서 확인한 값을 그대로 넣는다:
#     docker inspect nginx -f '{{(index .NetworkSettings.Networks "shared_network_prod").IPAddress}}'
#   IP 는 공개 저장소에 적지 않는다 — 아래 자리표시자를 서버의 .env.prod 에서만 바꾼다.
#   비우면 모든 요청이 nginx IP 로 보여 로그인 rate limit(5/minute)이 전 사용자 공용이 된다.
#   `*` 금지: uvicorn 이 클라이언트가 위조할 수 있는 X-Forwarded-For 값을 믿게 된다.
#   자리표시자 그대로면 deploy.sh 가 배포를 막는다(nginx IP 와 다름).
FORWARDED_ALLOW_IPS=<nginx-ip-on-shared_network_prod>

# --- 관측성 -----------------------------------------------------------------
# SENTRY_DSN: Sentry DSN. 미사용 시 빈 값(빈 문자열 degrade -> Sentry 비활성).
SENTRY_DSN=

# --- Firebase(참고) ---------------------------------------------------------
# 컨테이너 내 경로는 compose.prod.yaml 의 environment 에서 고정 주입한다:
#   FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/firebase_service_account
# 실제 키 파일은 secrets/firebase_service_account.json(compose secret)으로만 마운트한다.
